generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  category    String
  price       Int
  description String
  fabric      String?
  embroidery  String?
  images      String[]
  stock       String      @default("available")
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inquiries   Inquiry[]
}

model LookbookSpread {
  id        String   @id @default(cuid())
  title     String
  season    String
  images    Json
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  date      DateTime
  timeSlot  String
  type      String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model CustomOrder {
  id                String   @id @default(cuid())
  name              String
  phone             String
  email             String
  occasion          String
  budgetRange       String
  timeline          String
  description       String
  inspirationImages String[]
  status            String   @default("new")
  createdAt         DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String?
  phone     String?
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  occasion  String
  quote     String
  image     String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}
